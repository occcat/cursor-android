<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/cursor_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/usage_widget_name" android:textColor="@color/cursor_fg"
        android:textSize="18sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/usage_widget_description"
        android:textColor="@color/cursor_text_secondary" android:textSize="12sp"
        android:paddingTop="8dp" />
</LinearLayout>
